rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      return isSignedIn() && userDoc().role == 'admin';
    }

    function isActive() {
      return isSignedIn() && userDoc().disabled != true;
    }

    match /users/{userId} {
      // Qualquer utilizador autenticado pode ler o seu próprio perfil (para
      // verificar se está desativado); o admin pode ler todos.
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      // Só o admin pode criar/editar perfis (criação de utilizadores, desativação).
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    match /costumes/{costumeId} {
      allow read: if isActive() && (resource.data.ownerUid == request.auth.uid || isAdmin());
      allow create: if isActive() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isActive() && resource.data.ownerUid == request.auth.uid;
      // O admin também apaga (ao "apagar" um utilizador, os trajes dele são removidos).
      allow delete: if isActive() && (resource.data.ownerUid == request.auth.uid || isAdmin());
    }

    // Pets: mesma estrutura dos trajes (itens e secções próprios; as personagens são partilhadas com os trajes).
    match /pets/{petId} {
      allow read: if isActive() && (resource.data.ownerUid == request.auth.uid || isAdmin());
      allow create: if isActive() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isActive() && resource.data.ownerUid == request.auth.uid;
      allow delete: if isActive() && (resource.data.ownerUid == request.auth.uid || isAdmin());
    }

    match /petSections/{sectionId} {
      allow read: if isActive() && resource.data.ownerUid == request.auth.uid;
      allow create: if isActive() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isActive() && resource.data.ownerUid == request.auth.uid;
    }

    match /sections/{sectionId} {
      allow read: if isActive() && resource.data.ownerUid == request.auth.uid;
      allow create: if isActive() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isActive() && resource.data.ownerUid == request.auth.uid;
    }

    match /characters/{characterId} {
      allow read: if isActive() && resource.data.ownerUid == request.auth.uid;
      allow create: if isActive() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isActive() && resource.data.ownerUid == request.auth.uid;
    }

    // Preferências de notificação (Discord User ID, limiar de aviso) — só o
    // próprio dono lê/escreve. O Cloudflare Worker lê isto com credenciais de
    // serviço (Admin), que ignoram estas regras por completo.
    match /userSettings/{uid} {
      allow read, write: if isActive() && request.auth.uid == uid;
    }
  }
}
